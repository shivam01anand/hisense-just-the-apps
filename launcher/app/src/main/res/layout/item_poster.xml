<?xml version="1.0" encoding="utf-8"?>
<!-- One watchlist poster: 2:3, rounded, a white ring when focused, and IMDb's rating in the corner. Which
     app it opens in is deliberately not shown: pressing OK just opens it wherever it streams. The title shows until the poster file is decoded, and stays when there is none. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="180dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/poster_bg"
    android:foreground="@drawable/poster_ring"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:maxLines="6"
        android:ellipsize="end"
        android:textColor="#D9FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit" />

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />


    <TextView
        android:id="@+id/posterRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:background="@drawable/rating_bg"
        android:textColor="#D9FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:singleLine="true" />
</FrameLayout>
